[resource]
script = ExtResource("r1")
id = &"goblin"
display_name = "Goblins"
description = "Cheap, fragile and fast: their units cost less, have less health and strike faster."
accent_color = Color(0.56, 0.82, 0.35, 1)
unit_card_cost_multiplier = 0.8
hp_multiplier = 0.7
attack_speed_multiplier = 1.3
move_speed_multiplier = 1.1
unit_overrides = Array[ExtResource("r2")]([SubResource("unit_soldier"), SubResource("unit_archer"), SubResource("unit_priest"), SubResource("unit_tank")])
structure_overrides = Array[ExtResource("r3")]([SubResource("struct_farm"), SubResource("struct_soldier_barracks"), SubResource("struct_archer_barracks"), SubResource("struct_church"), SubResource("struct_tower")])
castle_texture = ExtResource("r18")
castle_team_texture = ExtResource("r19")
card_names = {"card_farm": "Mushroom Farm", "card_soldier_barracks": "Goblin Den", "card_archer_barracks": "Sniper Nest", "card_church": "Shaman Hut", "card_tower": "Spike Tower", "card_soldiers": "Goblin Soldiers", "card_archers": "Goblin Archers", "card_tank": "Goblin Brute"}
